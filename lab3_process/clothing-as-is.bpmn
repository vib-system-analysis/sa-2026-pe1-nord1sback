<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Clothing" targetNamespace="https://github.com/vib-system-analysis/sa-2026-pe1-nord1sback">
  <bpmn:collaboration id="Collaboration_0myfa3w">
    <bpmn:participant id="Participant_153hctt" name="Владелец гардероба" processRef="ClothingSelection" />
    <bpmn:participant id="Participant_1r31vxd" name="Близкий человек (только эпизод 3)" />
    <bpmn:messageFlow id="Flow_0v6q90w" name="Вопрос о сочетании цветов" sourceRef="check" targetRef="Participant_1r31vxd" />
    <bpmn:messageFlow id="Flow_15ggo3t" name="Оценка сочетания цветов" sourceRef="Participant_1r31vxd" targetRef="check" />
    <bpmn:textAnnotation id="TextAnnotation_1y70str">
      <bpmn:text>Модель объединяет три наблюдения перед выходом. Совет близкого отмечен только в эпизоде 3. Вечерняя подготовка не наблюдалась.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="ClothingSelection" name="Выбор одежды перед выходом" isExecutable="false">
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="prepare" />
    <bpmn:sequenceFlow id="f2" sourceRef="prepare" targetRef="check" />
    <bpmn:sequenceFlow id="f6" sourceRef="replace" targetRef="check" />
    <bpmn:sequenceFlow id="f3" sourceRef="check" targetRef="decision" />
    <bpmn:sequenceFlow id="f4" name="Да" sourceRef="decision" targetRef="end" />
    <bpmn:sequenceFlow id="f5" name="Нет" sourceRef="decision" targetRef="replace" />
    <bpmn:startEvent id="start" name="Пора выбрать одежду">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="prepare" name="Подобрать вещи">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:property id="Property_0rfgdir" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0ui8n5m">
        <bpmn:sourceRef>Data_Conditions</bpmn:sourceRef>
        <bpmn:targetRef>Property_0rfgdir</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0in4iel">
        <bpmn:targetRef>Data_Outfit</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="check" name="Примерить и проверить комплект">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:property id="Property_19pln5d" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0ue602q">
        <bpmn:sourceRef>Data_Outfit</bpmn:sourceRef>
        <bpmn:targetRef>Property_19pln5d</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0bly0n8">
        <bpmn:targetRef>Data_CheckResult</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="decision" name="Комплект подходит?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end" name="Комплект выбран">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="replace" name="Найти или заменить вещи">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:property id="Property_1glm1qp" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1gcrz9e">
        <bpmn:sourceRef>Data_CheckResult</bpmn:sourceRef>
        <bpmn:targetRef>Property_1glm1qp</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_09ab5ng">
        <bpmn:targetRef>Data_Outfit</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="Data_Conditions" name="Условия выбора:&#10;повод, погода,&#10;доступность вещей" dataObjectRef="DataObject_1wwpwnr" />
    <bpmn:dataObject id="DataObject_1wwpwnr" />
    <bpmn:dataObjectReference id="Data_Outfit" name="Состав комплекта:&#10;первоначальный /&#10;после замены" dataObjectRef="DataObject_11j83vu" />
    <bpmn:dataObject id="DataObject_11j83vu" />
    <bpmn:dataObjectReference id="Data_CheckResult" name="Результат проверки:&#10;что не подошло" dataObjectRef="DataObject_0pyk35a" />
    <bpmn:dataObject id="DataObject_0pyk35a" />
  </bpmn:process>
